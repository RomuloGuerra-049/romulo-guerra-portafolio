PORT=3000
NODE_ENV=development
SESSION_TTL_HOURS=168

# Administrador inicial. Solo se crea si las tres variables están presentes.
# Usa una contraseña larga y distinta en cada entorno.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-password-123

# Persistencia futura:
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/portfolio
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# Integración opcional del chat. Sin estas variables funciona en modo local.
N8N_CHAT_WEBHOOK_URL=
WHATSAPP_NUMBER=

# Cliente genérico opcional para desarrollo:
SEED_CLIENT_NAME=Cliente de prueba
SEED_CLIENT_EMAIL=cliente@example.com
SEED_CLIENT_PASSWORD=replace-with-a-test-password-123

# Gmail requiere verificación en dos pasos y una contraseña de aplicación.
MAIL_TO=owner@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=owner@example.com
SMTP_PASS=replace-with-a-google-app-password
